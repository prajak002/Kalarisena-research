<mujoco model="g1_29dof scene">
  <!-- Wrapper around Unitree's official 29-DoF G1 MJCF.
       g1_29dof_rev_1_0.xml is included verbatim (never edited) so the official
       actuator, contact and inertial parameters are preserved. It already
       supplies the floor geom, lighting and skybox, so all this file adds is
       CoM-tracking cameras for headless video capture. -->
  <include file="g1_29dof_rev_1_0.xml"/>

  <worldbody>
    <camera name="track" mode="trackcom" pos="2.4 -2.4 1.3"
            xyaxes="0.707 0.707 0 -0.29 0.29 0.91"/>
    <camera name="front" mode="trackcom" pos="2.3 0 1.0"
            xyaxes="0 1 0 -0.32 0 0.95"/>
    <camera name="side" mode="trackcom" pos="0 -2.3 1.0"
            xyaxes="1 0 0 0 0.32 0.95"/>
  </worldbody>
</mujoco>
